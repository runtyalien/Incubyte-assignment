# Copy to .env and adjust as needed.
ENVIRONMENT=development

# Shared secret the frontend sends as X-API-Key. Leave it empty locally and
# the API is open, which is what you want with `uvicorn --reload`. Set it in
# any deployment: with ENVIRONMENT=production the service refuses to start
# without one rather than coming up and serving salaries to anyone.
#
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# Comma-separated origins allowed to call this API cross-origin. The deployed
# frontend proxies through its own origin, so this is empty in production and
# only has a value here for anyone pointing a local UI at a remote API.
CORS_ORIGINS=http://localhost:3000
