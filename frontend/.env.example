# Copy to .env.local for local development.

# Where the backend is, as the Next server reaches it. Not NEXT_PUBLIC_, on
# purpose: the browser talks to this app's own origin and never to the API
# directly, so the address stays out of the bundle.
API_URL=http://localhost:8000

# Must match the backend's API_KEY. Server-side only, attached by the server
# components and by src/app/api/[...path]/route.ts on the browser's behalf.
# Leave empty locally if the backend has no key set.
API_KEY=

# The demo gate. Leave DEMO_PASSWORD empty and the app asks for nothing, which
# is what you want while developing. Set both in the deployment and every page
# is behind an HTTP Basic prompt.
DEMO_USER=hr
DEMO_PASSWORD=
